# ==========================================
# Zero9Repo backend configuration
# Copy to backend/.env and adjust:  cp .env.sample .env
# ==========================================

# ----- Database -----
# sqlite (default, no setup needed) | postgresql | mysql
DB_TYPE=sqlite

# Connection details for PostgreSQL (used when DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zero9repo

# Or configure the SQLAlchemy URL directly (overrides all DB_* values above)
# DATABASE_URL=sqlite+aiosqlite:///./data/zero9repo.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zero9repo

# ----- Server -----
HOST=0.0.0.0
PORT=8000
PUBLIC_URL=http://localhost:8000
SECRET_KEY=change-me-in-production

# ----- Default admin (seeded on first start) -----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@zero9repo.io
